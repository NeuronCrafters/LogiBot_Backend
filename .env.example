# =============================================================================
# LogiBot Backend — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de rodar localmente.
#
# ATENÇÃO — Deploy na Cloudflare:
#   Variáveis não-sensíveis já estão em wrangler.toml ([vars]).
#   Variáveis sensíveis (marcadas com *) devem ser configuradas via:
#     wrangler secret put NOME_DA_VARIAVEL
#   e NÃO devem ir para o wrangler.toml ou para o repositório.
# =============================================================================


# -----------------------------------------------------------------------------
# Banco de dados — MongoDB Atlas
# -----------------------------------------------------------------------------

# * URI completa de conexão com o MongoDB (inclui usuário, senha e cluster).
# Exemplo: mongodb+srv://usuario:senha@cluster.mongodb.net/nome_do_banco
MONGO_URI=


# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------

# * Segredo usado para assinar e verificar tokens JWT.
# Use uma string longa e aleatória (mínimo 32 caracteres).
JWT_SECRET=


# -----------------------------------------------------------------------------
# Segurança da API
# -----------------------------------------------------------------------------

# * Chave de API que o frontend envia no header "x-api-key".
# Deve ser o mesmo valor configurado em VITE_API_KEY no frontend.
API_KEY=


# -----------------------------------------------------------------------------
# URLs e CORS
# -----------------------------------------------------------------------------

# URL do frontend — usada para liberar CORS e gerar links de redefinição de senha.
# Em produção já está definida no wrangler.toml; só é necessária aqui para dev local.
FRONT_URL=http://localhost:5173

# Domínio usado para o cookie HTTP-only de sessão.
# Em produção já está definida no wrangler.toml (.saellogibot.com).
# Para dev local use "localhost".
COOKIE_DOMAIN=localhost


# -----------------------------------------------------------------------------
# Integração com Rasa (chatbot)
# -----------------------------------------------------------------------------

# * URL base do servidor Rasa (webhook REST).
# Exemplo: http://seu-servidor-rasa:5005
RASA_URL=

# * URL base do servidor de actions do Rasa.
# Exemplo: http://seu-servidor-rasa:5055
RASA_ACTION=


# -----------------------------------------------------------------------------
# Integração com OLLAMA (moderação por IA)
# -----------------------------------------------------------------------------

# Nome do modelo OLLAMA usado para moderação.
# Exemplo: llama3, mistral
OLLAMA_MODEL=

# URLs das instâncias OLLAMA (suporta até 20 instâncias para balanceamento).
# Pelo menos OLLAMA_API_URL_1 é necessária se a moderação estiver ativa.
OLLAMA_API_URL_1=
# OLLAMA_API_URL_2=
# OLLAMA_API_URL_3=
# ... até OLLAMA_API_URL_20

# Chaves de acesso para cada instância OLLAMA (se necessário).
Key_A1=
# Key_A2=
# Key_A3=
# ... até Key_A20


# -----------------------------------------------------------------------------
# Moderação de agentes
# -----------------------------------------------------------------------------

# * Configuração do agente de moderação (valor JSON ou identificador).
Agent_Moderation=

# * Chave do agente de moderação.
Key_Moderation=


# -----------------------------------------------------------------------------
# Ambiente (Express local apenas)
# -----------------------------------------------------------------------------

# Ambiente de execução. Use "development" localmente.
NODE_ENV=development

# Porta do servidor Express local (padrão: 3000).
PORT=3000
