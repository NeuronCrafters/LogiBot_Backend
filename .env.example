PORT=43187

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=10

HTTP_REQUEST_LOGS=true

# Auth / API
JWT_SECRET=
API_KEY=

# DIGITALOCEAN - Agent (LLM)
# Pool de ate 5 agents identicos balanceados por menor carga (DIGITALOCEAN_AGENT_<1-5>_ENDPOINT/_ACCESS_KEY).
# Nao ha mais um agent "padrao" isolado nem lista separada por virgulas - configure sempre pelo numero (1 a 5).
DIGITALOCEAN_AGENT_1_ENDPOINT=
DIGITALOCEAN_AGENT_1_ACCESS_KEY=
DIGITALOCEAN_AGENT_2_ENDPOINT=
DIGITALOCEAN_AGENT_2_ACCESS_KEY=
DIGITALOCEAN_AGENT_3_ENDPOINT=
DIGITALOCEAN_AGENT_3_ACCESS_KEY=
DIGITALOCEAN_AGENT_4_ENDPOINT=
DIGITALOCEAN_AGENT_4_ACCESS_KEY=
DIGITALOCEAN_AGENT_5_ENDPOINT=
DIGITALOCEAN_AGENT_5_ACCESS_KEY=
DIGITALOCEAN_AGENT_TIMEOUT_MS=30000

# Agent dedicado aos insights pedagógicos do dashboard
DASHBOARD_INSIGHTS_AGENT_ENDPOINT=
DASHBOARD_INSIGHTS_AGENT_ACCESS_KEY=
DASHBOARD_INSIGHTS_MODEL=openai-gpt-oss-20b
DASHBOARD_INSIGHTS_TIMEOUT_MS=90000

# Servico de Embeddings (VPS propria)
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_API_KEY=

# Timeout (ms) para chamadas de embedding no chat (query); ingestao usa 60000
EMBEDDING_QUERY_TIMEOUT_MS=15000

# ChromaDB
CHROMA_URL=
CHROMA_COLLECTION=logibots_rag_chunks

# RAG - Upload e Worker Server
# Em producao via Compose o volume e montado em /var/logibots/uploads/rag (definido no docker-compose.yml)
# RAG_UPLOAD_DIR=./uploads/rag
# Em Compose: http://worker:43188  |  Em producao separada: https://worker.saellogibot.com
RAG_WORKER_URL=http://worker:43188
RAG_WORKER_PORT=43188
RAG_WORKER_POLL_MS=5000

# URL interna do backend, usada pelo worker para encaminhar seus logs em tempo
# real via Socket.IO (namespace /internal/logs, autenticado com API_KEY).
# Em Compose: http://backend:43187
BACKEND_INTERNAL_URL=http://backend:43187

# SMTP / Emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# PASSWORD_RESET_DEBUG_RESPONSE=false
