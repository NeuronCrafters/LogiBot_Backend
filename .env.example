# Copie para .env em desenvolvimento ou configure no ambiente da VPS.

PORT=43187

# PostgreSQL
# Dokploy/host externo do LogiBot: use porta 5437 se estiver acessando o banco pelo host.
# Dentro da mesma stack/rede Docker, normalmente use a porta interna 5432 do servico Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=10
HTTP_REQUEST_LOGS=true

# Auth / API
JWT_SECRET=
API_KEY=

# SMTP / Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PASSWORD_RESET_DEBUG_RESPONSE=false
