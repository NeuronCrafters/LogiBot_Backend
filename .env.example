# Variaveis sensiveis: configure via "wrangler secret put NOME" para producao.
# Para dev local com Express, copie para .env e preencha.

# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth
JWT_SECRET=
API_KEY=

# CORS / Cookies
# Em producao ja definidas no wrangler.toml
FRONT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# Cloudflare Workers AI
# Modelo padrao: @cf/meta/llama-3.1-8b-instruct-fp8
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Ambiente (Express local)
NODE_ENV=development
PORT=3000
