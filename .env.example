PORT=43187
DATABASE_URL=postgresql://logibot:logibot_local@postgres:5432/logibot
DB_POOL_MAX=10
JWT_SECRET=
API_KEY=
HTTP_REQUEST_LOGS=true

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_TIMEOUT_CAP_MS=300000
OPENROUTER_MAX_CONCURRENCY=5
OPENROUTER_QUEUE_MAX_SIZE=100
OPENROUTER_QUEUE_TIMEOUT_MS=600000
AGENT_MAX_ATTEMPTS=3
AGENT_RETRY_DELAY_MS=1500
QUIZ_AI_GENERATION_TIMEOUT_MS=300000
DASHBOARD_INSIGHTS_TIMEOUT_MS=90000

SELF_RAG_DECISION_TIMEOUT_MS=60000
SELF_RAG_DECISION_QUEUE_TIMEOUT_MS=600000
SELF_RAG_FINAL_AGENT_TIMEOUT_MS=180000
SELF_RAG_FINAL_QUEUE_TIMEOUT_MS=600000
CHAT_WORKER_CONCURRENCY=5
CHAT_GENERATION_JOB_TIMEOUT_MS=600000
CHAT_GENERATION_MAX_ATTEMPTS=1

EMBEDDING_SERVICE_URL=http://embedding:8000
EMBEDDING_SERVICE_API_KEY=
EMBEDDING_QUERY_TIMEOUT_MS=15000
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=logibots_rag_chunks
RAG_WORKER_URL=http://worker:43188
RAG_WORKER_PORT=43188
RAG_WORKER_POLL_MS=5000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PASSWORD_RESET_DEBUG_RESPONSE=false

# Persistent sessions (server-side). Polling alone does not renew inactivity.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=7200
SESSION_SWEEP_CRON=* * * * *

# Test environment (separate database; must differ from DATABASE_URL)
SANDBOX_DATABASE_URL=postgresql://logibot:logibot_local@postgres:5432/logibots_sandbox
# Password of every @dev.sael.com test account (12+ characters)
SANDBOX_PASSWORD=
SANDBOX_EMAIL_DOMAIN=dev.sael.com
# Platform owners (support), comma separated: admins who can use the Dev area
OWNER_EMAILS=owner@logibots.com
OWNER_PASSWORD=
