# Copie para .env em desenvolvimento ou configure no ambiente da VPS.

NODE_ENV=development
PORT=3004

# PostgreSQL
# Dokploy/host externo do LogiBot: use porta 5437 se estiver acessando o banco pelo host.
# Dentro da mesma stack/rede Docker, normalmente use a porta interna 5432 do servico Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=10

# Auth / API
JWT_SECRET=
API_KEY=

# CORS / Cookies
FRONT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
