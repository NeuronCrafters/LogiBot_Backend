{
  "name": "logibot_backend",
  "version": "0.0.1",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest --runInBand",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/workerServer.js",
    "worker:dev": "tsx src/workerServer.ts",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed2": "tsx src/db/seed2.ts",
    "db:seed:experiment": "tsx src/db/seedRagExperiment.ts",
    "db:seed:experiment2": "tsx src/db/seedRagExperimentRound2.ts",
    "db:seed:loadtest": "tsx src/db/seedLoadTest.ts",
    "db:seed:ifpa": "tsx src/db/seedIfpa.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "chromadb": "^3.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-useragent": "^1.0.15",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.26.0",
    "@faker-js/faker": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.13",
    "@types/express-useragent": "^1.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.18.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "ttypescript": "^1.5.15",
    "typescript-transform-paths": "^3.5.5"
  }
}
